# -----------------------------------------------------------------------------
# InternTrack environment configuration (EXAMPLE)
#
# Copy this file to `.env` and adjust the values:
#     Windows (PowerShell):  Copy-Item .env.example .env
#     macOS / Linux:         cp .env.example .env
#
# `.env` is read by BOTH Django (config/settings.py) and Docker Compose
# (docker-compose.yml), so the database credentials only live in one place.
#
# NEVER commit `.env`. It is listed in .gitignore.
# The values below are placeholders for LOCAL DEVELOPMENT ONLY.
# -----------------------------------------------------------------------------

# --- Django ------------------------------------------------------------------
# Generate your own key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# True for local development only. Must be False in any shared/production setup.
DJANGO_DEBUG=True

# Comma-separated list of host names Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Time zone used for stored/displayed dates (IANA name, e.g. UTC, Asia/Kolkata).
DJANGO_TIME_ZONE=UTC

# --- PostgreSQL --------------------------------------------------------------
# Used by docker-compose.yml to create the database AND by Django to connect.
POSTGRES_DB=interntrack
POSTGRES_USER=interntrack
POSTGRES_PASSWORD=replace-me-with-a-local-db-password

# Where Django finds the database. With the Docker setup this is your own
# machine. Use 127.0.0.1 rather than "localhost": on Windows "localhost" may
# resolve to IPv6 (::1) first, which Docker does not publish to, adding a
# multi-second delay to every connection.
# Change POSTGRES_PORT (e.g. 5433) if 5432 is already in use.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Seconds Django waits when opening a DB connection before giving up.
# Keeps /health/ responsive when the database is down.
POSTGRES_CONNECT_TIMEOUT=5
